# 실제 API 키와 비밀번호를 GitHub에 올리지 마세요.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-locally
MYSQL_DATABASE=drone_weather_news
OPENAI_API_KEY=replace-locally
# AI 기사 생성 및 RAG 챗봇에서 사용할 모델
OPENAI_MODEL=gpt-5.6-terra

# 실습용 MySQL 쓰기 API 기본 비활성화. 로컬에서만 true 사용.
ENABLE_DEMO_CRUD=false
